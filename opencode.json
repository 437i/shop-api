{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "frontend/AGENTS.md"
  ],
  "mcp": {
    "backend-dev": {
      "type": "local",
      "command": [
        "go",
        "run",
        "./cmd/backend-mcp"
      ],
      "cwd": "tools/backend-mcp",
      "enabled": true,
      "timeout": 10000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": { "CONTEXT7_API_KEY": "ctx7sk-c3294f40-d97a-48b9-8359-9a6ce4cb4517" },
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    }
  },
  "tools": {
    "context7_*": false,
    "playwright_*": false,
    "backend-dev_*": false
  },
  "share": "disabled",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "npm run typecheck": "allow",
      "npm run lint": "allow",
      "npm run test*": "allow",
      "npm run build": "allow",
      "npm run api:types": "allow",
      "docker compose ps": "allow",
      "docker compose logs*": "allow",
      "git push*": "ask",
      "git reset*": "ask",
      "docker compose down*": "ask",
      "docker volume rm*": "deny",
      "docker system prune*": "deny",
      "rm -rf*": "deny"
    }
  }
}