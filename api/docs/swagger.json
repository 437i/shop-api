    "definitions": {
        "address.CreateRequest": {
            "type": "object",
            "required": [
                "city",
                "country",
                "street"
            ],
            "properties": {
                "city": {
                    "type": "string",
                    "maxLength": 255,
                    "example": "Москва"
                },
                "country": {
                    "type": "string",
                    "maxLength": 255,
                    "example": "Россия"
                },
                "street": {
                    "type": "string",
                    "maxLength": 255,
                    "example": "Ленина, 10"
                }
            }
        },
        "address.Response": {
            "type": "object",
            "properties": {
                "city": {
                    "type": "string",
                    "example": "Москва"
                },
                "country": {
                    "type": "string",
                    "example": "Россия"
                },
                "id": {
                    "type": "string"
                },
                "street": {
                    "type": "string",
                    "example": "Ленина, 10"
                }
            }
        },
        "category.CreateRequest": {
            "type": "object",
            "required": [
                "name"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "maxLength": 255,
                    "example": "Холодильники"
                }
            }
        },
        "category.Response": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string",
                    "example": "Холодильники"
                }
            }
        },
        "client.CreateRequest": {
            "type": "object",
            "required": [
                "address",
                "birthday",
                "gender",
                "name",
                "surname"
            ],
            "properties": {
                "address": {
                    "$ref": "#/definitions/address.CreateRequest"
                },
                "birthday": {
                    "type": "string",
                    "example": "1986-09-12"
                },
                "gender": {
                    "type": "string",
                    "enum": [
                        "m",
                        "f",
                        "n/a"
                    ],
                    "example": "m"
                },
                "name": {
                    "type": "string",
                    "maxLength": 255,
                    "example": "Иван"
                },
                "surname": {
                    "type": "string",
                    "maxLength": 255,
                    "example": "Иванов"
                }
            }
        },
        "client.Response": {
            "type": "object",
            "properties": {
                "address": {
                    "$ref": "#/definitions/address.Response"
                },
                "birthday": {
                    "type": "string",
                    "example": "1986-09-12"
                },
                "gender": {
                    "type": "string",
                    "example": "m"
                },
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string",
                    "example": "Иван"
                },
                "registration_date": {
                    "type": "string",
                    "format": "date-time",
                    "example": "2026-09-12T12:00:00Z"
                },
                "surname": {
                    "type": "string",
                    "example": "Иванов"
                }
            }
        },
        "client.UpdateAddressRequest": {
            "type": "object",
            "properties": {
                "address": {
                    "$ref": "#/definitions/address.CreateRequest"
                }
            }
        },
        "image.CreateResponse": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                }
            }
        },
        "product.CreateRequest": {
            "type": "object",
            "required": [
                "available_stock",
                "category",
                "name",
                "price",
                "supplier_id"
            ],
            "properties": {
                "available_stock": {
                    "type": "integer",
                    "example": 5
                },
                "category": {
                    "$ref": "#/definitions/category.CreateRequest"
                },
                "name": {
                    "type": "string",
                    "maxLength": 255,
